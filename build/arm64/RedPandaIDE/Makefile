install_target: first FORCE
	@test -d $(INSTALL_ROOT)/Users/rajib/RedPanda-CPP/pkg/arm64/bin || mkdir -p $(INSTALL_ROOT)/Users/rajib/RedPanda-CPP/pkg/arm64/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/Users/rajib/RedPanda-CPP/pkg/arm64/bin/RedPandaIDE.app
	
	$(QINSTALL) RedPandaIDE.app $(INSTALL_ROOT)/Users/rajib/RedPanda-CPP/pkg/arm64/bin/RedPandaIDE.app
	-$(STRIP) $(INSTALL_ROOT)/Users/rajib/RedPanda-CPP/pkg/arm64/bin/RedPandaIDE.app/Contents/MacOS/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/Users/rajib/RedPanda-CPP/pkg/arm64/bin/RedPandaIDE.app
	-$(DEL_DIR) $(INSTALL_ROOT)/Users/rajib/RedPanda-CPP/pkg/arm64/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

